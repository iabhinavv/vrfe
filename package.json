{
  "name": "vrfe-website",
  "version": "1.0.0",
  "description": "VR Personal Finance Education Website",
  "main": "index.html",
  "scripts": {
    "start": "live-server --host=localhost --port=3000",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/css/style.css --watch",
    "dev": "concurrently \"npm run build:css\" \"npm run start\""
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "tailwindcss": "^3.3.0",
    "concurrently": "^8.2.0",
    "autoprefixer": "^10.4.14"
  },
  "keywords": ["finance", "education", "investing"],
  "author": "VRFE Team",
  "license": "MIT"
}

